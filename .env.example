# demo (default): noindex, nofollow, no sitemap, concept footer line.
# live: index, follow, sitemap. Launch day only. See SEO-LAUNCH.md.
NEXT_PUBLIC_SITE_MODE=demo
# Base URL for canonicals, Open Graph, sitemap and JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: corporate form or CRM endpoint. When set, each quote request is also POSTed there as JSON.
NEXT_PUBLIC_LEAD_ENDPOINT=
